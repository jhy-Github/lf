(function() {
            // 该客户研发认为这个js文件影响网页插件进线
            const ua = window.navigator.userAgent.toLowerCase();
            if (/MicroMessenger/.test(ua) || /miniprogram/.test(ua)) {
                const hm = document.createElement("script");
                hm.async = true;
                hm.src = "https://res.wx.qq.com/open/js/jweixin-1.6.0.js";
                const s = document.getElementsByTagName("script")[0];
                s.parentNode.insertBefore(hm, s);
            }
        })();
        window.onerror = function(message, source, lineno, colno, error) {
            // 判断错误是否是 JS 文件加载失败引起的，并获取 URL，并重新加载该文件
            if (typeof source === 'string' && source.includes(".js") && source.indexOf('udeskglobal')>-1) {
                if(error){
                    const script = document.createElement('script');
                    const newSource=source.replace('static-ud.udeskglobal.com','static-ud.s5.udesk.cn');
                    script.src = newSource;
                    script.onerror = function() {
                        console.log("JS 文件加载失败，URL：" + source);
                    };
                    document.head.appendChild(script);
                }
            }
            return false;
        };
        (function() {
            const ogUrl = document.querySelector('meta[property="og:url"]');
            const staticUd="https://static-ud.s4.udesk.cn";
            if (ogUrl && ogUrl.content ==='https://www.udesk.cn/' && staticUd.indexOf('udeskglobal')>-1) {
                ogUrl.content = 'https://www.udeskglobal.com/';
            }
        })();